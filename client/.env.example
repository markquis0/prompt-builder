# Not needed for local dev — the Vite dev server proxies /api to the
# backend (see vite.config.js), so this can stay unset locally.
#
# In production (e.g. on Vercel), set this to your deployed backend's
# origin, with no trailing slash:
# VITE_API_BASE_URL=https://prompt-builder-api.onrender.com
VITE_API_BASE_URL=

# Formspree form ID for the result-screen feedback widget (uses the
# official @formspree/react SDK, i.e. useForm(formId) — NOT the full
# https://formspree.io/f/... URL, just the ID at the end of it).
# Create a free form at https://formspree.io to get one.
# If unset, the widget submit will fail gracefully with a retry banner —
# it will never crash the app.
# VITE_FEEDBACK_FORM_ID=your-form-id
VITE_FEEDBACK_FORM_ID=

# PostHog project key for funnel-event tracking (prompt_submitted,
# qa_completed, prompt_copied, etc. — see client/src/main.jsx and the
# posthog.capture() calls throughout client/src). Separate from Formspree
# above, which stays dedicated to the feedback widget's own submissions.
# Get your key from your PostHog project settings.
# If unset, posthog.init() never runs and all posthog.capture() calls are
# silent no-ops — the app behaves identically either way.
VITE_POSTHOG_KEY=

# Your PostHog project's region — check your PostHog project settings,
# do NOT assume US is correct. Common values:
#   US cloud: https://us.i.posthog.com
#   EU cloud: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
