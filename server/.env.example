# Copy this file to .env and fill in your key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides
PORT=3001
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Comma-separated list of origins allowed to call this API.
# Local dev defaults to the Vite dev server if unset.
# In production, set this to your deployed frontend's origin, e.g.:
# ALLOWED_ORIGIN=https://prompt-builder.vercel.app
ALLOWED_ORIGIN=http://localhost:5173

# --- Auth / DB (Monetisation Gate, Stage 1) ---
# This MUST be set on the Render backend service's own Environment tab —
# never on Vercel. Vercel only serves the static frontend; it doesn't run
# this Express app or read this variable.
# Use Render's Postgres "Internal Database URL" (same-region, no SSL needed).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Also Render-only, never Vercel. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Set to "true" only if DATABASE_URL points at Render's External Database
# URL instead of the Internal one (external requires SSL, internal doesn't).
# DATABASE_SSL=true

# --- Stripe (Monetisation Gate, Stage 3) ---
# All Render-only, never Vercel. Test-mode values first (sk_test_...) —
# don't switch to live keys until the full flow is verified end to end.
STRIPE_SECRET_KEY=sk_test_your-key-here

# The recurring monthly Price ID from your "PromptMe Pro" Product in the
# Stripe dashboard (Products -> PromptMe Pro -> the $5/month Price).
STRIPE_PRICE_ID=price_your-price-id-here

# From Stripe's webhook endpoint config (Developers -> Webhooks -> your
# endpoint -> Signing secret). This doesn't exist until AFTER you've
# deployed this code and registered the webhook URL in Stripe, since the
# URL has to exist first — see README for the exact order.
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# Used for Stripe Checkout's success/cancel redirect and the billing
# portal's return URL. Your deployed frontend origin, no trailing slash.
FRONTEND_URL=https://promptme.host
